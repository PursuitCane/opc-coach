# 复制为 .env（.env 已被 gitignore，不会提交）
#
# 服务端变量：不要使用 VITE_ 前缀；它们只由 Node 读取，绝不会打进浏览器。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/opc_sage
AUTH_SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
AUTH_CODE_SECRET=replace-with-a-different-random-string-at-least-32-characters
RESEND_API_KEY=re_your_resend_api_key
# 必须是 Resend 已验证域名下的发件人。测试时可用 Resend 提供的测试发件人。
EMAIL_FROM="OPC 军师 <login@your-domain.com>"
PORT=8787

# 前端变量：VITE_* 会打包进浏览器，不能放 Resend 或数据库密钥。
# 目前 AI 调用仍沿用既有前端直连配置；上线前建议也迁到 Node API。

VITE_OPENAI_BASE_URL=https://api.openai-next.com/v1
VITE_OPENAI_API_KEY=sk-your-limited-key-here
VITE_OPENAI_MODEL=gpt-5
